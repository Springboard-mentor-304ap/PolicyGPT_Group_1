# ============================================================
# POLICYGPT BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================

# Database URL (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/policygpt_db

# Security & JWT
SECRET_KEY=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=False

# Default Platform SMTP (Fallback)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password
SMTP_FROM_EMAIL=noreply@policygpt.gov.in
SMTP_FROM_NAME=PolicyGPT

# ============================================================
# BREVO EMAIL & SMS CONFIGURATION (PARTS 38, 39, 41)
# ============================================================
BREVO_ENABLED=true

# Brevo HTTP API Key (v3)
BREVO_API_KEY=your_brevo_api_key

# Brevo SMTP Credentials
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_PASSWORD=your_brevo_smtp_password

# Verified Sender Information
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=PolicyGPT

# Brevo Transactional SMS Sender (Max 11 alphanumeric characters)
BREVO_SMS_SENDER=PolicyGPT

# Shared secret Brevo echoes back in the X-Brevo-Webhook-Secret header on the
# /webhooks/brevo/* callbacks. Leave blank to accept callbacks unauthenticated
# (the pre-existing behaviour). Set it in production so delivery status
# updates cannot be forged.
BREVO_WEBHOOK_SECRET=

# Feature Flags & Modes
BREVO_EMAIL_ENABLED=true
BREVO_SMS_ENABLED=true
BREVO_SANDBOX_MODE=false
MAX_NOTIFICATION_RETRIES=3

# Password-reset abuse protection (OTP + reset-link requests per user/hour).
# Token lifetimes match the pre-existing 5-min OTP / 15-min reset defaults.
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=5
OTP_EXPIRE_MINUTES=5
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15

# Live notification push. With REALTIME enabled the browser holds a WebSocket
# to /ws/notifications; on failure it falls back to polling the unread count.
NOTIFICATIONS_REALTIME_ENABLED=true

# ============================================================
# POLICYGPT ASSISTANT (CHATBOT)
# ============================================================
CHATBOT_ENABLED=true
# Server-side guest usage cap (messages per guest user).
CHATBOT_GUEST_MESSAGE_LIMIT=5
CHATBOT_MAX_MESSAGE_LENGTH=2000
CHATBOT_MAX_HISTORY=20
CHATBOT_RATE_LIMIT=30
CHATBOT_RATE_LIMIT_WINDOW_SECONDS=60
# Response provider: template (grounded default) or openai.
CHATBOT_PROVIDER=template
# Only required when CHATBOT_PROVIDER=openai. Never commit a real key.
CHATBOT_OPENAI_API_KEY=
CHATBOT_OPENAI_MODEL=gpt-4o-mini

# Primary frontend URL used for links in emails and other user-facing
# backend-generated URLs. Production must set the real deployed domain, e.g.
# FRONTEND_URL=https://your-production-frontend-domain.com
FRONTEND_URL=http://localhost:4200

# Extra frontend origins for CORS (comma-separated). Required when the
# frontend is served from a host other than localhost:4200, otherwise
# export (blob) downloads fail the preflight on other systems.
# Example: FRONTEND_ORIGINS=https://app.example.com
# Production: FRONTEND_ORIGINS=https://your-production-frontend-domain.com
FRONTEND_ORIGINS=http://localhost:4200,http://127.0.0.1:4200

# NOTE: the fallback poll interval is a frontend constant (15s, in
# notification-realtime.service.ts), chosen to fire between the client's
# reconnect attempts. This server-side value is not currently read by any
# endpoint, so changing it has no effect on the browser.
NOTIFICATIONS_FALLBACK_POLL_SECONDS=60
