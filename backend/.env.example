# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=your_postgresql_database_url


# ============================================================
# SECURITY & JWT
# ============================================================
SECRET_KEY=your_super_secret_jwt_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=False


# ============================================================
# DEFAULT PLATFORM SMTP (FALLBACK)
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password

SMTP_FROM_EMAIL=noreply@policygpt.gov.in
SMTP_FROM_NAME=PolicyGPT


# ============================================================
# BREVO EMAIL CONFIGURATION
# ============================================================
# Brevo is used for EMAIL delivery.
BREVO_ENABLED=true

# Brevo HTTP API Key
# Optional if the application uses Brevo SMTP.
BREVO_API_KEY=your_brevo_api_key

# Brevo SMTP credentials
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your_brevo_smtp_user
BREVO_SMTP_PASSWORD=your_brevo_smtp_password

# Verified Brevo sender
BREVO_SENDER_EMAIL=your_verified_sender@example.com
BREVO_SENDER_NAME=PolicyGPT

# Brevo webhook secret
BREVO_WEBHOOK_SECRET=your_brevo_webhook_secret

# Email feature flag
BREVO_EMAIL_ENABLED=true

# Brevo sandbox mode
BREVO_SANDBOX_MODE=false


# ============================================================
# TWILIO SMS OTP CONFIGURATION (OTP-ONLY VIA TWILIO VERIFY)
# ============================================================
# Twilio Account SID
# Starts with AC...
TWILIO_ACCOUNT_SID=your_twilio_account_sid

# Twilio API Key SID
# Starts with SK...
TWILIO_API_KEY=your_twilio_api_key_sid

# Twilio API Key Secret / Client Secret
# NEVER commit a real secret.
TWILIO_API_SECRET=your_twilio_api_secret

# Master switch for Twilio SMS OTP delivery
TWILIO_SMS_ENABLED=true

# Twilio Verify Service SID (starts with VA...)
# Required for Forgot Password SMS OTP, which uses Twilio Verify's
# trial-approved OTP template. Create the "PolicyGPT OTP" Verify Service
# ONCE via backend/scripts/provision_twilio_verify.py (or the Twilio
# Console) and paste its SID here. SMS is OTP-only; there is no other
# SMS sender. NEVER commit a real SID.
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid


# ============================================================
# NOTIFICATION CONFIGURATION
# ============================================================
MAX_NOTIFICATION_RETRIES=3

# Real-time browser notifications
NOTIFICATIONS_REALTIME_ENABLED=true

# Fallback polling interval in seconds
NOTIFICATIONS_FALLBACK_POLL_SECONDS=60


# ============================================================
# PASSWORD RESET / OTP CONFIGURATION
# ============================================================
# Maximum password reset / OTP requests per user per hour
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=5

# OTP expiration time in minutes
OTP_EXPIRE_MINUTES=5

# Password reset token expiration time in minutes
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=15


# ============================================================
# POLICYGPT ASSISTANT / CHATBOT
# ============================================================
CHATBOT_ENABLED=true

# Server-side guest message limit
CHATBOT_GUEST_MESSAGE_LIMIT=5

# Maximum chatbot message length
CHATBOT_MAX_MESSAGE_LENGTH=2000

# Maximum conversation history
CHATBOT_MAX_HISTORY=20

# Rate limit
CHATBOT_RATE_LIMIT=30
CHATBOT_RATE_LIMIT_WINDOW_SECONDS=60

# Response provider
# Options: template / openai
CHATBOT_PROVIDER=template

# Required only when CHATBOT_PROVIDER=openai
CHATBOT_OPENAI_API_KEY=

# OpenAI model
CHATBOT_OPENAI_MODEL=gpt-4o-mini


# ============================================================
# FRONTEND / CORS
# ============================================================
# Main frontend URL
# Example:
# FRONTEND_URL=https://your-production-frontend-domain.com
FRONTEND_URL=

# Additional frontend origins
# Multiple origins can be comma-separated.
# Example:
# FRONTEND_ORIGINS=https://app.example.com,https://www.example.com
FRONTEND_ORIGINS=